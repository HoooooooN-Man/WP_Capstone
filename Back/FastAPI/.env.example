# Back/FastAPI/.env.example
# 이 파일을 .env 로 복사한 뒤 값 수정. 모든 변수는 *옵션* (기본값 있음).
#
# 자동 점검: 각 변수의 default 와 사용처는 Back/FastAPI/core/config.py 참조.

# ── 데이터 경로 ─────────────────────────────────────────────────────────────

# Capstone Data 루트 (기본: WP_Capstone 의 상위 폴더)
# CAPSTONE_ROOT=E:\Capstone Data

# DuckDB 경로 (시장/스코어/재무 — read-only)
# DUCKDB_PATH=E:\Capstone Data\WP_Capstone\Back\FastAPI\scores.duckdb

# 뉴스 적재 DuckDB (db 서버가 쓰기, 본 서버는 읽기) — DUCKDB_PATH 와 다른 파일이어야 함
# NEWS_DUCKDB_PATH=E:\Capstone Data\WP_Capstone\Back\db\db\news_data.duckdb

# 게시판 SQLite (Tier 1.6 SoR 정책: PostgreSQL 단일화 후 fixture 전용)
# BOARD_DB_PATH=E:\Capstone Data\WP_Capstone\Back\FastAPI\board.db

# Holdout 박제 디렉터리 override (기본: <CAPSTONE_ROOT>/../_archive/holdout_2026_q1_q2/)
# HOLDOUT_ARCHIVE_DIR=E:\Capstone Data\_archive\holdout_2026_q1_q2

# ── Redis ──────────────────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_CACHE_TTL=60
# 비밀번호는 REDIS_QUEUE_PASSWORD 우선, 없으면 REDIS_PASSWORD 폴백
# REDIS_QUEUE_PASSWORD=
# REDIS_PASSWORD=

# ── CORS ───────────────────────────────────────────────────────────────────

# CORS 화이트리스트 — 콤마 구분, 운영 시 실제 도메인으로 교체.
# 미설정 시 로컬 Vite 개발 서버(5173, 4173) 만 허용.
# CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com

# ── 실시간 시세 (Tier 1.7 / WebSocket) ─────────────────────────────────────

# 시세 소스 라벨. 프론트가 "시뮬레이션" 배지 노출 여부 결정.
# 값: "simulation" (현재 ±0.3% 무작위) | "live" (KIS API 등 실연동 시).
# PRICE_PROVIDER=simulation
# PRICE_DELAY_MS=0

# WebSocket 옵션
# WS_TICK_INTERVAL_SECONDS=2.0
# WS_MAX_TICKERS=20
