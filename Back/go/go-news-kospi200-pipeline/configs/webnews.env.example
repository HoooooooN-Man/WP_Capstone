# ============================================================
# Webnews Daily Batch Environment Example
# ============================================================
# Copy this file to configs/webnews.env and edit secrets locally.
#
# Local/WSL test:
# - REDIS_QUEUE_HOST can be your NetBird IP.
# - REDIS_QUEUE_PORT can be 6380 if redis-queue is exposed there.
#
# Oracle Cloud operation:
# - Redis and Webnews run on the same VM.
# - Prefer localhost communication.
# - NetBird is only for SSH/admin access.
# ============================================================

REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=CHANGE_ME
REDIS_QUEUE_DB=0
REDIS_QUEUE_PROTOCOL=2

POLL_BLOCK=2s
REQUEST_TIMEOUT=10s

WEBNEWS_REDIS_PREFIX=webnews
WEBNEWS_DATA_DIR=./data/webnews
WEBNEWS_CATEGORIES_FILE=./configs/webnews_categories.json

WEBNEWS_TIMEZONE=Asia/Seoul
WEBNEWS_MARKET_OPEN_HOUR=9
WEBNEWS_MARKET_OPEN_MINUTE=0
WEBNEWS_TOP_N=10

WEBNEWS_FETCH_TIMEOUT_SECONDS=10
WEBNEWS_USER_AGENT=Mozilla/5.0 WP-Capstone-WebNewsBot/1.0
WEBNEWS_KEEP_LAST_GOOD=1