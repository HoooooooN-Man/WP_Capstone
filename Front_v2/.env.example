# WP Capstone Frontend v2 — 환경 변수
# 본 파일을 .env.local 로 복사 후 값 수정

# ML API (FastAPI :8001) — 추천/검색/스크리너/종목상세/적정주가/배당
VITE_API_ML=http://localhost:8001

# Auth/Board API (FastAPI :8000) — 인증/관심종목/포트폴리오/게시판
VITE_API_AUTH=http://localhost:8000

# WebSocket 실시간 시세 — 위 VITE_API_ML 의 ws:// 자동 사용
# (vite.config.ts proxy 가 처리)

# 데모 모드 (PRD §2.3) — true 면 로그인 우회·Onboarding 건너뜀
VITE_DEMO_MODE=false

# 운영 모델 버전 (latest = 자동)
VITE_MODEL_VERSION=latest
